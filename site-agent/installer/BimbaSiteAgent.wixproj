<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- BIMBA-Site-Agent.msi for Intune / SCCM / Group Policy. Packs the (already signed) BIMBA-Site-Agent-Setup.exe from
       ..\dist. Build through ..\..\scripts\build-site-agent.ps1, which passes Version and signs the result.
       WiX Toolset 5 (MS-RL licence; WiX 6 and later have a maintenance fee for commercial use). -->
  <PropertyGroup>
    <OutputName>BIMBA-Site-Agent</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <DefineConstants>Version=$(Version);AgentExe=$(MSBuildThisFileDirectory)..\dist\BIMBA-Site-Agent-Setup.exe</DefineConstants>
    <SuppressValidation>false</SuppressValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
