# Copy to .env and fill in to start the Boomi Atom:  docker compose --profile boomi up -d
# Get the token in Boomi AtomSphere: Manage > Atom Management > New > Atom > Docker install
BOOMI_INSTALL_TOKEN=
BOOMI_ATOMNAME=BIMBA-POC-Atom
# Optional: attach the Atom to an existing environment
BOOMI_ENVIRONMENTID=
