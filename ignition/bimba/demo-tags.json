          "engUnit": "bpm"
        },
        {
          "name": "temperature",
          "tagType": "AtomicTag",
          "valueSource": "expr",
          "expression": "60 + 5 * sin(toMillis(now(1000)) / 90000.0)",
          "dataType": "Float8",
          "engUnit": "degC"
        },
        {
          "name": "running",
          "tagType": "AtomicTag",
          "valueSource": "expr",
          "expression": "getSecond(now(1000)) < 50",
          "dataType": "Boolean"
        },
        {
          "name": "state",
          "tagType": "AtomicTag",
          "valueSource": "expr",
          "expression": "if(getSecond(now(1000)) < 50, 'RUNNING', 'IDLE')",
