# Copy to .env on the VM (cp .env.example .env) and fill in. Never commit .env.

# Public address of the VM. No domain yet? Use sslip.io with the VM's public IP, dots kept:
#   PUBLIC_IP=129.146.10.20      DOMAIN=129.146.10.20.sslip.io
PUBLIC_IP=
DOMAIN=

# Shared PostgreSQL (must accept connections from the internet / from this VM)
BIMBA_DB_HOST=
BIMBA_DB_PORT=6433
BIMBA_DB_NAME=bimba_chromalab
BIMBA_DB_USER=
BIMBA_DB_PASSWORD=
BIMBA_DB_SCHEMA=bimba_ignition

# Encrypts destination secrets in the database. Generate once:  openssl rand -hex 32
# Keep the same value for the life of the database; empty = a key file in the data volume
BIMBA_SECRET_KEY=

# Boomi Event Streams produce token (optional until you deliver to Boomi)
BOOMI_ES_PRODUCE_TOKEN=
