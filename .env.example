# Copy to .env, then: docker compose --profile boomi up -d
# Boomi AtomSphere > Manage > Runtime Management > New > Atom > (Docker) > generate installer token
BOOMI_INSTALL_TOKEN=
BOOMI_ATOMNAME=BIMBA-POC-Atom
BOOMI_ENVIRONMENTID=

# Django Event Streams consumer (set with scripts/set-eventstreams-consumer.ps1)
BOOMI_ES_CONSUME_URL=https://usa-east-web.eventstreams.boomi.com/rest/consume/easystepinitservicesllc-4ZNYGO/d98ab861-8bc0-4a65-a6f2-a8dcc47b4e94/BIMBA/BIMBA-SCADA
BOOMI_ES_CONSUME_TOKEN=

# Shared PostgreSQL for Django + Boomi (required; set with scripts/set-database.ps1).
# BIMBA objects live in schema BIMBA_DB_SCHEMA, so other tables in the database are untouched.
BIMBA_DB_HOST=103.120.176.105
BIMBA_DB_PORT=6433
BIMBA_DB_NAME=bimba_chromalab
BIMBA_DB_USER=
BIMBA_DB_PASSWORD=
BIMBA_DB_SCHEMA=bimba
